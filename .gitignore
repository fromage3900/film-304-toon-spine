# Unreal Engine
/Binaries/
/DerivedDataCache/
/Intermediate/
/.vs/

# --- Saved/ ------------------------------------------------------------------
# Render output is NOT versioned: the contact sheets in Saved/Audit are ~6 MB of
# PNGs and they are regenerated by Blender/stage_brutalist_review.py in minutes.
#
# Written as /Saved/* rather than /Saved/ ON PURPOSE. Git cannot re-include a
# file whose PARENT DIRECTORY is excluded, so `/Saved/` would make every
# `!` rule below a silent no-op - the classic gitignore trap. Excluding the
# CONTENTS keeps the directory traversable, which is what lets the evidence
# allowlist work.
/Saved/*
!/Saved/Audit/
!/Saved/Reports/
/Saved/Audit/*
/Saved/Reports/*
# Evidence we DO version: the assertion reports, manifests and gate ledgers.
# A report plus the harness that produced it is evidence; a PNG on its own is not.
!/Saved/Audit/*.json
!/Saved/Audit/*.md
!/Saved/Audit/*.txt
!/Saved/Reports/*.json
!/Saved/Reports/*.md
!/Saved/Reports/*.txt
# ... and never the caches/intermediates that live alongside them.
/Saved/Previews/
/Saved/Blend/
/Saved/Intermediate/
/Saved/Logs/
/.vscode/
*.VC.db
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Don't ignore Content/ — this is a content-first repo
!Content/

# World Partition external actor/object plumbing — TRACKED, deliberately.
# POLICY REVERSED 2026-10-01. These were gitignored on the theory that they are
# "regenerated with the .umap". They are not: for a World Partition level the
# external actor packages *are* the actor data. Ignoring them meant a fresh
# clone opened L_Toon_Lookdev with its actors missing (audit finding F1).
# The fix is to commit them, so the level is reproducible on any clone.
# Consequence: the directory is large and churns when the level is resaved.
# Regenerate it with Python/build_test_level.py, never by hand.
!Content/__ExternalActors__/
!Content/__ExternalObjects__/
